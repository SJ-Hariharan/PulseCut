# PulseCut environment variables (reference template).
#
# PulseCut does NOT read a .env file. Copying this file to .env has no effect.
# To use these settings, export them in your shell before starting PulseCut, for example:
#   export PULSECUT_HOME=/path/to/data-root
#
# Secrets are never configured through environment variables. OBS passwords, API keys,
# OAuth tokens, client secrets and the Kick public key are stored in the OS keychain
# (macOS Keychain / Windows Credential Manager) from the Settings screen.

# Overrides the application data and config root (config/, data/, cache/ subdirectories).
# When unset, PulseCut uses the platform default (for example ~/Library/Application Support/PulseCut
# on macOS). Useful for tests and portable installs.
PULSECUT_HOME=

# Directory where the real-FFmpeg render test copies its output video and thumbnail for manual
# inspection. Used only by the render integration test; when unset, the artefacts are discarded.
PULSECUT_KEEP_RENDER=

# Log filter for the desktop app and CLI, in tracing EnvFilter syntax (for example "debug" or
# "pulsecut_engine=debug,obws=warn"). When unset, the default is "info,obws=warn,sqlx=warn,eframe=warn".
RUST_LOG=
